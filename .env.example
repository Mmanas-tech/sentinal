# Optional generic external event endpoint. Contract: JSON array or {"events": [...]}.
SENTINAL_HTTP_URL=
SENTINAL_HTTP_TOKEN=
SENTINAL_HTTP_SOURCE_ID=external-http
SENTINAL_HTTP_TIMEOUT=10
SENTINAL_HTTP_RETRIES=2
SENTINAL_HTTP_BACKOFF=0.5

# Optional Open-Meteo endpoint override for tests or a controlled proxy.
# The default is the documented public endpoint and does not require a key.
SENTINAL_OPEN_METEO_URL=

# Optional local bearer authentication for mutating API routes.
SENTINAL_AUTH_REQUIRED=false
SENTINAL_API_TOKEN=

# Optional runtime SQLite location.
SENTINAL_DB_PATH=.sentinal/sentinal.db

# Optional remote Keras autoencoder repository for /api/v1/ml/telemetry/analyze.
# The local Isolation Forest path does not require this setting.
SENTINAL_HF_TELEMETRY_MODEL=keras-io/timeseries-anomaly-detection
